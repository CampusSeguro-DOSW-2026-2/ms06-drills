# Copy to infra/.env to change the defaults (infra/.env is ignored by git).
DB_NAME=campusseguro_events
DB_USER=campusseguro
DB_PASSWORD=campusseguro
DB_PORT=5433

# API Gateway integration. GATEWAY_SERVICE_KEY is the MS06 key (>= 32 characters)
# configured in the Gateway as GW_SERVICE_KEY_MS06.
GATEWAY_URL=http://localhost:8080
GATEWAY_SERVICE_KEY=
# Fallback identity for events started by the scheduler when the creator id is not a UUID.
GATEWAY_SYSTEM_USER_ID=
GATEWAY_SYSTEM_USER_ROLE=ORGANIZADOR
