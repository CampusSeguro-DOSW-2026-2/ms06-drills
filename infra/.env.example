# Copy to infra/.env to change the defaults for LOCAL development (infra/.env is ignored by git).
# In a deployed environment the values come from the GitHub Environment ms06-<env>, not from this file.
DB_NAME=campusseguro_events
DB_PORT=5433

# Deployed environments use a managed PostgreSQL instance (RDS), one database per environment.
# TLS is mandatory: with `rds.force_ssl=1` an unencrypted connection is rejected, so the URL
# must carry `sslmode=require`. DB_USER is the application role, never the RDS master user.
DB_URL=jdbc:postgresql://database-ms06.cv2f07iwqjsk.us-east-1.rds.amazonaws.com:5432/campusseguro_events?sslmode=require
DB_USER=ms06_user
DB_PASSWORD=

# API Gateway integration. GATEWAY_SERVICE_KEY is the MS06 key (>= 32 characters)
# configured in the Gateway as GW_SERVICE_KEY_MS06.
GATEWAY_URL=http://localhost:8080
GATEWAY_SERVICE_KEY=
# Fallback identity for events started by the scheduler when the creator id is not a UUID.
GATEWAY_SYSTEM_USER_ID=
GATEWAY_SYSTEM_USER_ROLE=ORGANIZADOR
# Optional: permissions of the system user (default in application.yml)
GATEWAY_SYSTEM_USER_PERMISSIONS=
